rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isEnterpriseOwner(enterpriseDoc) {
      return isAuthenticated() && (
        enterpriseDoc.owner_id == request.auth.uid ||
        enterpriseDoc.userId == request.auth.uid ||
        enterpriseDoc.ownerId == request.auth.uid ||
        enterpriseDoc.createdBy == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /enterprises/{enterpriseId} {
      allow read, create: if isAuthenticated();
      // Allow updates while preventing removal/override of the enterprise owner
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isEnterpriseOwner(resource.data);
      
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /clients/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /fournisseurs/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /articles/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /invoices/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /quotes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /delivery_notes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /customer_orders/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /supplier_orders/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /purchase_invoices/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /receiving_vouchers/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /credit_notes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /supplier_credit_notes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /return_notes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /supplier_returns/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_entries/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_movements/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_withdrawals/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_transfers/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory_sheets/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /treasury_accounts/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /treasury_transactions/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /paiements/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /projects/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /warehouses/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /document_templates/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /company_settings/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /product_families/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /checks_traites/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /support_tickets/{docId} {
      // Allow reading tickets only for authenticated users
      allow read: if isAuthenticated();

      // Restrict ticket creation: must be authenticated with valid constrained payload
      allow create: if isAuthenticated() &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 2 &&
        request.resource.data.subject.size() <= 200 &&
        (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000));

      // Allow ticket status and lastMessage updates by authenticated users
      allow update: if isAuthenticated();

      // Disallow deleting tickets to prevent loss of audit trails
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();

        // Enforce strict size and type constraints to prevent base64 bombs & bot flooding
        allow create: if isAuthenticated() &&
          (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 4000)) &&
          (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 4000)) &&
          (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 650000));

        // Allow read status / acknowledgment updates
        allow update: if isAuthenticated();

        // Disallow message deletion
        allow delete: if false;
      }

      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /subscription_payments/{docId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
