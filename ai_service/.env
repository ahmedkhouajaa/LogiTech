# ===================================================================
# LogiTech ERP - AI Extraction Service Configuration
# ===================================================================
# Remplissez ces informations avec les accès fournis par votre ami :

# 1. URL de l'API du modèle IA de votre ami
# Exemple: https://api.votre-ami.com/v1/extract-document
AI_MODEL_URL=

# 2. Clé d'API ou Token d'accès (si fourni par votre ami)
AI_MODEL_API_KEY=

# 3. Type d'authentification (Bearer, Api-Key, ou none)
AI_AUTH_TYPE=Bearer

# 4. Paramètres de serveur
PORT=8000
HOST=0.0.0.0
